<Window x:Class="Cinema.Views.SeatSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cinema · Alege locurile" Width="1050" Height="760" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#171B31" Padding="30,23">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="FilmTitleText" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="ScreeningDetailsText" Foreground="#AEB4CA" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Content="Închide" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                        Padding="14,8" Click="Close_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="30" HorizontalAlignment="Center">
                <Border Width="620" Height="15" CornerRadius="8" Background="#D7DAE4" Margin="0,5,0,8"/>
                <TextBlock Text="ECRAN" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Grid x:Name="SeatsGrid" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <Border Width="18" Height="18" CornerRadius="5" Background="#F0F2F7" BorderBrush="#DDE0E8" BorderThickness="1"/>
                        <TextBlock Text="Disponibil" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Selectat" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <Border Width="18" Height="18" CornerRadius="5" Background="#F5C8CD"/>
                        <TextBlock Text="Ocupat" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrushModern}" BorderThickness="0,1,0,0" Padding="30,19">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,38,0">
                        <TextBlock Text="LOCURI SELECTATE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedSeatsText" Text="Niciun loc" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TOTAL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TotalText" Text="0.00 lei" FontWeight="Bold" FontSize="20" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ConfirmButton" Content="Confirmă rezervarea" HorizontalAlignment="Right"
                        Width="205" Height="48" IsEnabled="False" Click="Confirm_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
