<Window x:Class="Cinema.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cinema" Width="1320" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="24,28,20,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="C" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Cinema" Foreground="White" FontWeight="Bold" FontSize="20"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENIU" Foreground="#69718D" FontSize="10" FontWeight="Bold" Margin="26,12,0,7"/>
                    <Button x:Name="HomeNavButton" Content="Acasă" Tag="home" Style="{StaticResource SidebarButton}" Click="Navigate_Click"/>
                    <Button x:Name="BookingNavButton" Content="Rezervă bilete" Tag="booking" Style="{StaticResource SidebarButton}" Click="Navigate_Click"/>
                    <Button x:Name="MyReservationsNavButton" Content="Rezervările mele" Tag="my-reservations" Style="{StaticResource SidebarButton}" Click="Navigate_Click"/>

                    <StackPanel x:Name="AdminNavigation" Visibility="Collapsed">
                        <TextBlock Text="ADMINISTRARE" Foreground="#69718D" FontSize="10" FontWeight="Bold" Margin="26,28,0,7"/>
                        <Button x:Name="AdminNavButton" Content="Administrare" Tag="admin" Style="{StaticResource SidebarButton}" Click="Navigate_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="16,12,16,22">
                    <Border Background="#1B2035" CornerRadius="12" Padding="13" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="17" Background="#6D5DFB">
                                <TextBlock x:Name="InitialsText" Text="U" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="RoleText" Foreground="#8991AD" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Content="Ieșire din cont" Style="{StaticResource SidebarButton}" Click="Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushModern}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <TextBlock x:Name="PageTitleText" Text="Acasă" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentDateText" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
