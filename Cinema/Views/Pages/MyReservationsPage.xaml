<Page x:Class="Cinema.Views.Pages.MyReservationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Rezervările mele" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Consultă biletele și anulează rezervările viitoare dacă este nevoie."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Reîmprospătează" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Refresh_Click"/>
                <Button Content="Anulează rezervarea" Style="{StaticResource DangerButton}" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,24,0,0" Padding="0">
            <Grid>
                <DataGrid x:Name="ReservationsGrid" IsReadOnly="True" BorderThickness="0" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cod" Binding="{Binding BookingCode}" Width="125"/>
                        <DataGridTextColumn Header="Film" Binding="{Binding FilmTitle}" Width="1.5*"/>
                        <DataGridTextColumn Header="Sala" Binding="{Binding RoomName}" Width="100"/>
                        <DataGridTextColumn Header="Data și ora" Binding="{Binding StartLabel}" Width="145"/>
                        <DataGridTextColumn Header="Locuri" Binding="{Binding Seats}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:0.00} lei}" Width="105"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="EmptyReservationsPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="C" Foreground="#5B4ED1" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nu ai încă nicio rezervare" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="După ce alegi un film și locurile, rezervarea va apărea aici."
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
