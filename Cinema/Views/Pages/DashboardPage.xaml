<Page x:Class="Cinema.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <Border Style="{StaticResource CardBorder}" Background="#171B31" BorderThickness="0" Padding="28">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="GreetingText" Text="Bine ai venit" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        <TextBlock x:Name="SubtitleText" Text="Iată ce se întâmplă astăzi în cinema."
                                   Foreground="#AEB4CA" FontSize="14" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Background="#6D5DFB" CornerRadius="18" Width="66" Height="66" HorizontalAlignment="Right">
                        <TextBlock Text="★" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="FILME ACTIVE" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="FilmsText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0">
                    <StackPanel>
                        <TextBlock Text="PROIECȚII VIITOARE" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="ScreeningsText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="10,0">
                    <StackPanel>
                        <TextBlock x:Name="ThirdCardLabel" Text="UTILIZATORI ACTIVI" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="UsersText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="FourthCardLabel" Text="ÎNCASĂRI" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="RevenueText" Text="0 lei" FontSize="25" FontWeight="Bold" Margin="0,13,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock x:Name="RecentTitleText" Text="Rezervări recente" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Cele mai noi activități din aplicație" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Height="260">
                        <DataGrid x:Name="RecentGrid" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cod" Binding="{Binding BookingCode}" Width="125"/>
                                <DataGridTextColumn Header="Utilizator" Binding="{Binding UserName}" Width="*"/>
                                <DataGridTextColumn Header="Film" Binding="{Binding FilmTitle}" Width="1.5*"/>
                                <DataGridTextColumn Header="Data și ora" Binding="{Binding StartLabel}" Width="145"/>
                                <DataGridTextColumn Header="Locuri" Binding="{Binding Seats}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:0.00} lei}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="RecentEmptyPanel" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentSoftBrush}">
                                <TextBlock Text="C" Foreground="#5B4ED1" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nu există rezervări de afișat" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="Rezervările noi vor apărea aici."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
