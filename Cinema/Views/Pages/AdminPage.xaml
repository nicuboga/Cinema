<Page x:Class="Cinema.Views.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Administrare" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Gestionează filmele, programul, sălile, conturile și rezervările."
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,20,0,0" Padding="12">
            <TabControl x:Name="AdminTabs" Background="White" BorderThickness="0">
                <TabItem Header="Filme">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Film nou" Click="NewFilm_Click"/>
                            <Button Content="Editează" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="EditFilm_Click"/>
                            <Button Content="Activează / dezactivează" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ToggleFilm_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="FilmsGrid" Grid.Row="1" IsReadOnly="True" MouseDoubleClick="FilmsGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Titlu" Binding="{Binding Title}" Width="1.7*"/>
                                <DataGridTextColumn Header="Gen" Binding="{Binding Genre}" Width="*"/>
                                <DataGridTextColumn Header="An" Binding="{Binding ReleaseYear}" Width="65"/>
                                <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="75"/>
                                <DataGridTextColumn Header="Durată" Binding="{Binding DurationMinutes}" Width="75"/>
                                <DataGridTextColumn Header="Preț bază" Binding="{Binding BasePrice, StringFormat={}{0:0.00} lei}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Săli">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Sală nouă" Click="NewRoom_Click"/>
                            <Button Content="Editează" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="EditRoom_Click"/>
                            <Button Content="Activează / dezactivează" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ToggleRoom_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="RoomsGrid" Grid.Row="1" IsReadOnly="True" MouseDoubleClick="RoomsGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sală" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="*"/>
                                <DataGridTextColumn Header="Etaj" Binding="{Binding Floor}" Width="80"/>
                                <DataGridTextColumn Header="Rânduri" Binding="{Binding Rows}" Width="90"/>
                                <DataGridTextColumn Header="Locuri / rând" Binding="{Binding SeatsPerRow}" Width="110"/>
                                <DataGridTextColumn Header="Capacitate" Binding="{Binding Capacity}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Programări">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Programare nouă" Click="NewScreening_Click"/>
                            <Button Content="Editează" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="EditScreening_Click"/>
                            <Button Content="Elimină din program" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteScreening_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="ScreeningsGrid" Grid.Row="1" IsReadOnly="True" MouseDoubleClick="ScreeningsGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Film" Binding="{Binding FilmTitle}" Width="1.5*"/>
                                <DataGridTextColumn Header="Sală" Binding="{Binding RoomName}" Width="*"/>
                                <DataGridTextColumn Header="Data" Binding="{Binding DateLabel}" Width="100"/>
                                <DataGridTextColumn Header="Ora" Binding="{Binding TimeLabel}" Width="75"/>
                                <DataGridTextColumn Header="Preț" Binding="{Binding Price, StringFormat={}{0:0.00} lei}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Actori">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Actor nou" Click="NewActor_Click"/>
                            <Button Content="Editează" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="EditActor_Click"/>
                            <Button Content="Șterge" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteActor_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="ActorsGrid" Grid.Row="1" IsReadOnly="True" MouseDoubleClick="ActorsGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="1.3*"/>
                                <DataGridTextColumn Header="An naștere" Binding="{Binding BirthYear}" Width="110"/>
                                <DataGridTextColumn Header="Naționalitate" Binding="{Binding Nationality}" Width="*"/>
                                <DataGridTextColumn Header="Film" Binding="{Binding FilmTitle}" Width="1.4*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Utilizatori">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Utilizator nou" Click="NewUser_Click"/>
                            <Button Content="Editează / resetează parola" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="EditUser_Click"/>
                            <Button Content="Activează / dezactivează" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ToggleUser_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="UsersGrid" Grid.Row="1" IsReadOnly="True" MouseDoubleClick="UsersGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nume" Binding="{Binding FullName}" Width="1.5*"/>
                                <DataGridTextColumn Header="Utilizator" Binding="{Binding Username}" Width="*"/>
                                <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                                <DataGridTextColumn Header="Creat la" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Rezervări">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Actualizează lista" Style="{StaticResource SecondaryButton}" Click="RefreshReservations_Click"/>
                            <Button Content="Anulează rezervarea" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="CancelReservation_Click"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="ReservationsGrid" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cod" Binding="{Binding BookingCode}" Width="120"/>
                                    <DataGridTextColumn Header="Client" Binding="{Binding UserName}" Width="*"/>
                                    <DataGridTextColumn Header="Film" Binding="{Binding FilmTitle}" Width="1.3*"/>
                                    <DataGridTextColumn Header="Data și ora" Binding="{Binding StartLabel}" Width="140"/>
                                    <DataGridTextColumn Header="Locuri" Binding="{Binding Seats}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:0.00} lei}" Width="95"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="EmptyAdminReservationsPanel" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Nu există rezervări" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Rezervările clienților vor apărea aici."
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Arhivă">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Aici sunt păstrate rezervările preluate din versiunea anterioară a aplicației."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <DataGrid x:Name="LegacyGrid" Grid.Row="1" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID vechi" Binding="{Binding LegacyId}" Width="80"/>
                                <DataGridTextColumn Header="Film ID" Binding="{Binding LegacyFilmId}" Width="80"/>
                                <DataGridTextColumn Header="Sală ID" Binding="{Binding LegacyRoomId}" Width="80"/>
                                <DataGridTextColumn Header="Ora" Binding="{Binding ShowTime}" Width="80"/>
                                <DataGridTextColumn Header="Data cumpărării" Binding="{Binding PurchaseDate}" Width="150"/>
                                <DataGridTextColumn Header="Locuri" Binding="{Binding Seats}" Width="*"/>
                                <DataGridTextColumn Header="Sursă" Binding="{Binding Source}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
